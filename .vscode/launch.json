    "version": "0.2.0",
    "configurations": [

        {
            "name": "local_inference",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/inference_local.py",
            "console": "integratedTerminal",
            "stopOnEntry": true
        },
        {
            "name": "finetune lora",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/local/train/finetune_lora.py",
            "console": "integratedTerminal",
            "args": ["--epochs", "3", "--batch-size", "64"],
            "stopOnEntry": true
        }
    ]
}