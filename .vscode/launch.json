{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "compile and profile",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/platform/compile_and_profile.py",
            "console": "integratedTerminal",
            "stopOnEntry": true,
            "args": ["--precision", "int8-compile"],
            "env": { "PYTHONPATH": "${workspaceFolder}" }
        },
        {
            "name": "finetune lora",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/local/train/finetune_lora.py",
            "console": "integratedTerminal",
            "args": ["--epochs", "3", "--batch-size", "64"],
            "stopOnEntry": true,
            "env": { "PYTHONPATH": "${workspaceFolder}" }
        },
        {
            "name": "debug quant issue",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/debug/stage_runner.py",
            "console": "integratedTerminal",
            "args": ["--precision", "int8-hub"],
            "stopOnEntry": true,
            "env": { "PYTHONPATH": "${workspaceFolder}" }
        }
    ]
}